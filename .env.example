# Copy this file to `.env` (dev) and set real values. Never commit `.env`.
# In production these are set in the Cloudflare Pages dashboard.

# Email (Resend)
RESEND_API_KEY=

# Supabase
SUPABASE_URL=https://rfvgjyfrjawqpdpwicev.supabase.co
SUPABASE_ANON_KEY=
# Service role key — server-side only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_KEY=

# SignalWire (phone calls / recordings)
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_FROM_NUMBER=

# AI (OpenAI-compatible chat) — used for reports and call analysis
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# Call recording + AI analysis of inbound conversations
# Recording turns on automatically when YIDDISHLABS_API_KEY is set; force with this flag.
# CALL_RECORDING_ENABLED=true
YIDDISHLABS_API_KEY=
# YIDDISHLABS_LANGUAGE=auto        # auto | yi | en | he | lk
# Shared secret that guards the Yiddish Labs transcription webhook.
CALL_WEBHOOK_SECRET=
# Optional: absolute base URL for provider callbacks (e.g. https://school.pages.dev)
# PUBLIC_BASE_URL=
